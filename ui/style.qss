/* ============================================================
   Orin NX 地面站配置工具 — 深色主题
   ============================================================ */

* {
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget#centralWidget, QDialog {
    background-color: #1b1f27;
}
QWidget {
    color: #d7dce3;
    outline: none;
}

/* ---------- 输入框 / 下拉框 ---------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #242a34;
    border: 1px solid #343c49;
    border-radius: 5px;
    padding: 5px 8px;
    color: #e6ebf2;
    selection-background-color: #2f6fd6;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #3b82f6;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: #1f242c;
    color: #5b6572;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #242a34;
    border: 1px solid #343c49;
    color: #e6ebf2;
    selection-background-color: #2f5fb0;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #2b3240;
    border: 1px solid #3a4351;
    border-radius: 5px;
    padding: 6px 16px;
    color: #e6ebf2;
}
QPushButton:hover {
    background-color: #333c4c;
    border-color: #4a5568;
}
QPushButton:pressed {
    background-color: #232936;
}
QPushButton:disabled {
    background-color: #20252e;
    color: #59626e;
    border-color: #2b3240;
}

/* ---------- 分组框 ---------- */
QGroupBox {
    border: 1px solid #343c49;
    border-radius: 6px;
    margin-top: 12px;
    background-color: #20262f;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9fb3c8;
}

/* ---------- 标签页 ---------- */
QTabWidget::pane {
    border: 1px solid #343c49;
    border-radius: 5px;
    background-color: #1b1f27;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #8b95a5;
    padding: 8px 20px;
    border: 1px solid transparent;
    border-bottom: none;
    margin-right: 2px;
}
QTabBar::tab:selected {
    color: #ffffff;
    background-color: #262c37;
    border: 1px solid #343c49;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}
QTabBar::tab:hover:!selected {
    color: #cbd5e1;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #20262f;
    alternate-background-color: #242b35;
    border: 1px solid #343c49;
    border-radius: 5px;
    gridline-color: #2c3440;
    color: #d7dce3;
    selection-background-color: #2f5fb0;
}
QHeaderView::section {
    background-color: #262c37;
    color: #9fb3c8;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #343c49;
    border-bottom: 1px solid #343c49;
}
QTableWidget QTableCornerButton::section {
    background-color: #262c37;
    border: none;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #242a34;
    border: 1px solid #343c49;
    border-radius: 5px;
    height: 18px;
    text-align: center;
    color: #e6ebf2;
}
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2f6fd6, stop:1 #3b82f6);
    border-radius: 4px;
}

/* ---------- 复选框 / 单选钮 ---------- */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: #d7dce3;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator {
    border: 1px solid #4a5568;
    border-radius: 3px;
    background-color: #242a34;
}
QCheckBox::indicator:checked {
    background-color: #2f6fd6;
    border-color: #2f6fd6;
}
QRadioButton::indicator {
    border: 1px solid #4a5568;
    border-radius: 8px;
    background-color: #242a34;
}
QRadioButton::indicator:checked {
    border: 4px solid #3b82f6;
    background-color: #ffffff;
}

/* ---------- 日志面板 ---------- */
QPlainTextEdit {
    background-color: #171b22;
    border: 1px solid #343c49;
    border-radius: 5px;
    color: #9fb3c8;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3a4351;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4a5568;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3a4351;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 消息框 ---------- */
QMessageBox QPushButton {
    min-width: 70px;
}
